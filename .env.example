# Copia este archivo como .env y reemplaza los valores. NUNCA subas el .env a GitHub.

# MongoDB Atlas: cadena de conexión (Atlas > Connect > Drivers). Cambia USUARIO y CONTRASENA.
MONGO_URI=mongodb+srv://USUARIO:CONTRASENA@TU-CLUSTER.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGO_DB=infraestructura_alcaldia

# Redis (Redis Cloud o local): redis://default:CONTRASENA@HOST:PUERTO
# Si es Redis local sin contraseña: redis://localhost:6379
REDIS_URL=redis://default:CONTRASENA@HOST:PUERTO

# Tiempos de vida en Redis (segundos)
CACHE_TTL_SEGUNDOS=60
CUADRILLA_TTL_SEGUNDOS=300
